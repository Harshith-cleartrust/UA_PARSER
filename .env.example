# Copy to `.env` — gitignored. Put your Firecrawl key after = (no quotes).
FIRECRAWL_API_KEY=fc-8c31136cbe7749138a3d9aef8ec9d7c8

# Optional: UA_PARSE_CACHE=1 saves each /api/parse snapshot and, on the next parse (same UA + client hints),
# fills hardware in order: JSON file → GSMArena → HVMS dataset (browser/OS/crawler still from the live parser).
# UA_PARSE_CACHE=1
# UA_PARSE_CACHE_PATH=   # default: <same dir as hvms dataset>/ua_parse_cache.json (e.g. dataset_files/)
# UA_PARSE_CACHE_TTL_DAYS=30
# UA_PARSE_CACHE_MAX_ENTRIES=400

# Model-key cache: dataset_files/model_parse_cache.json — entries keyed by normalized model (e.g. sms721u).
# When MODEL_PARSE_CACHE=1, hardware comes ONLY from this file (no GSMArena/HVMS/UA cache on /api/parse).
# npm start sets MODEL_PARSE_CACHE=1 by default. Use npm run start:full for layered UA + GSMArena + HVMS.
# MODEL_PARSE_CACHE=1
# MODEL_PARSE_CACHE_PATH=
# MODEL_PARSE_CACHE_TTL_DAYS=365
# MODEL_PARSE_CACHE_WRITE=1   # allow runtime writes to model_parse_cache.json (default: read-only)
