# Copy to `.env` — gitignored. Single file for Node server + Python crawler (`crawler/main.py`).
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Crawler (crawler/main.py) — optional; defaults shown
# USE_FIRECRAWL=true
# REQUEST_DELAY_MIN=10
# REQUEST_DELAY_MAX=18
# MAX_BRANDS_PER_RUN=10
# PAGE_DELAY_SEC=2
# Crawler writes here by default (same as parser MODEL_PARSE_CACHE):
# MODEL_PARSE_CACHE_PATH=dataset_files/model_parse_cache.json
# SMARTPHONE_OUTPUT_FILE=   # override dataset path only if needed
# SMARTPHONE_PROGRESS_FILE=crawler/progress.json

# Optional: UA_PARSE_CACHE=1 saves each /api/parse snapshot and, on the next parse (same UA + client hints),
# fills hardware in order: JSON file → GSMArena → HVMS dataset (browser/OS/crawler still from the live parser).
# UA_PARSE_CACHE=1
# UA_PARSE_CACHE_PATH=   # default: <same dir as hvms dataset>/ua_parse_cache.json (e.g. dataset_files/)
# UA_PARSE_CACHE_TTL_DAYS=30
# UA_PARSE_CACHE_MAX_ENTRIES=400

# Model-key cache: dataset_files/model_parse_cache.json — entries keyed by normalized model (e.g. sms721u).
# When MODEL_PARSE_CACHE=1, hardware comes ONLY from this file (no GSMArena/HVMS/UA cache on /api/parse).
# npm start sets MODEL_PARSE_CACHE=1 by default. Use npm run start:full for layered UA + GSMArena + HVMS.
# MODEL_PARSE_CACHE=1
# MODEL_PARSE_CACHE_PATH=
# MODEL_PARSE_CACHE_TTL_DAYS=365
# MODEL_PARSE_CACHE_WRITE=1   # allow runtime writes to model_parse_cache.json (default: read-only)

# Audit log (JSON Lines, one event per /api/parse and /api/ai-analyze call)
# AUDIT_LOG=1
# AUDIT_LOG_PATH=./data/audit   # directory; writes ./data/audit/2026-05-29.jsonl per day
# AUDIT_LOG_UA_MODE=truncate   # truncate | full | hash
# AUDIT_LOG_UA_MAX_CHARS=2048

# MCP (Model Context Protocol) — POST /mcp
# MCP_ENABLED=1
# MCP_AGENT_AUTH=1          # require apiKey on tools after register (set 0 to disable)
# AGENT_REGISTRATION_SECRET=   # if set, register_agent / POST /api/agents/register must send it
# AGENT_REGISTRY_PATH=./data/agents/registry.json
